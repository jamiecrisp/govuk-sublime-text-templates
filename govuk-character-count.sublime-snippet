<snippet>
	<content><![CDATA[
<div class="govuk-form-group govuk-character-count" data-module="govuk-character-count" data-maxlength="${1:200}">
	<h1 class="govuk-label-wrapper">
		<label class="govuk-label govuk-label--l" for="${2:with-hint}">
			${3:Can you provide more detail?}
		</label>
	</h1>
	<div id="${2:with-hint}-hint" class="govuk-hint">
		${4:Do not include personal or financial information}
	</div>
	<textarea class="govuk-textarea govuk-js-character-count" id="${2:with-hint}" name="${5:withHint}" rows="5" aria-describedby="${2:with-hint}-info ${2:with-hint}-hint"></textarea>
	<div id="${2:with-hint}-info" class="govuk-hint govuk-character-count__message">
		You can enter up to ${1:200} characters
	</div>
</div>
]]></content>
	<tabTrigger>govuk-character-count</tabTrigger>
	<scope>text.html</scope>
	<description>GOV.UK Character count component</description>
</snippet>
