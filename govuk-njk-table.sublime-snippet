<snippet>
	<content><![CDATA[
{{ govukTable({
	caption: "${1:Caption}",
	captionClasses: "govuk-table__caption--m",
	firstCellIsHeader: true,
	head: [
		{ text: "${2:Column 1}" },
		{ text: "${3:Column 2}" }
	],
	rows: [
		[
			{ text: "${4:Row 1}" },
			{ text: "${5:Data}" }
		],
		[
			{ text: "${6:Row 2}" },
			{ text: "${7:Data}" }
		]
	]
}) }}
]]></content>
	<tabTrigger>gds-njk-table</tabTrigger>
	<scope>text.html,source.nunjucks</scope>
	<description>GOV.UK Table (Nunjucks)</description>
</snippet>
