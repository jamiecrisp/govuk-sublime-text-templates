<snippet>
	<content><![CDATA[
{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{% set ${1:tab1}Html %}
<h2 class="govuk-heading-l">${2:Tab 1}</h2>
${3}
{% endset -%}

{% set ${4:tab2}Html %}
<h2 class="govuk-heading-l">${5:Tab 2}</h2>
${6}
{% endset -%}

{{ govukTabs({
	items: [
		{
			label: "${2:Tab 1}",
			id: "${7:tab-1}",
			panel: {
				html: ${1:tab1}Html
			}
		},
		{
			label: "${5:Tab 2}",
			id: "${8:tab-2}",
			panel: {
				html: ${4:tab2}Html
			}
		}
	]
}) }}
]]></content>
	<tabTrigger>govuk-njk-tabs</tabTrigger>
	<scope>text.html,source.nunjucks</scope>
	<description>GOV.UK Tabs (Nunjucks)</description>
</snippet>
