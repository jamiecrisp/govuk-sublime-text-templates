<snippet>
	<content><![CDATA[
<table class="govuk-table">
	<caption class="govuk-table__caption govuk-table__caption--m">${1:Caption}</caption>
	<thead class="govuk-table__head">
		<tr class="govuk-table__row">
			<th scope="col" class="govuk-table__header">${2:Column 1}</th>
			<th scope="col" class="govuk-table__header">${3:Column 2}</th>
		</tr>
	</thead>
	<tbody class="govuk-table__body">
		<tr class="govuk-table__row">
			<th scope="row" class="govuk-table__header">${4:Row 1}</th>
			<td class="govuk-table__cell">${5:Data}</td>
		</tr>
		<tr class="govuk-table__row">
			<th scope="row" class="govuk-table__header">${6:Row 2}</th>
			<td class="govuk-table__cell">${7:Data}</td>
		</tr>
	</tbody>
</table>
]]></content>
	<tabTrigger>gds-table</tabTrigger>
