<snippet>
	<content><![CDATA[
<ul class="govuk-task-list">
	<li class="govuk-task-list__item govuk-task-list__item--with-link">
		<div class="govuk-task-list__name-and-hint">
			<a class="govuk-link govuk-task-list__link" href="${1:#}" aria-describedby="${2:task-1}-status">
				${3:Task name}
			</a>
		</div>
		<div class="govuk-task-list__status" id="${2:task-1}-status">
			${4:Completed}
		</div>
	</li>
	<li class="govuk-task-list__item govuk-task-list__item--with-link">
		<div class="govuk-task-list__name-and-hint">
			<a class="govuk-link govuk-task-list__link" href="${5:#}" aria-describedby="${6:task-2}-status">
				${7:Another task}
			</a>
		</div>
		<div class="govuk-task-list__status" id="${6:task-2}-status">
			<strong class="govuk-tag govuk-tag--blue">
				${8:Incomplete}
			</strong>
		</div>
	</li>
</ul>
]]></content>
	<tabTrigger>gds-task-list</tabTrigger>
	<scope>text.html</scope>
	<description>GOV.UK Task list component</description>
</snippet>
