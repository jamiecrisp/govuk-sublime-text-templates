<snippet>
	<content><![CDATA[
{% set html %}
	<p class="govuk-body">We use some essential cookies to make this service work.</p>
	<p class="govuk-body">We'd also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
{% endset %}

{{ govukCookieBanner({
	ariaLabel: "Cookies on ${1:service name}",
	messages: [
		{
			headingText: "Cookies on ${1:service name}",
			html: html,
			actions: [
				{
					text: "Accept analytics cookies",
					type: "button"
				},
				{
					text: "Reject analytics cookies",
					type: "button"
				},
				{
					text: "View cookies",
					href: "${2:#}"
				}
			]
		}
	]
}) }}
]]></content>
	<tabTrigger>govuk-njk-cookie-banner</tabTrigger>
	<scope>text.html,source.nunjucks</scope>
	<description>GOV.UK Cookie Banner (Nunjucks)</description>
</snippet>
