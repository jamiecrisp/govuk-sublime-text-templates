<snippet>
	<content><![CDATA[
<div class="govuk-error-summary" data-module="govuk-error-summary">
	<div role="alert">
		<h2 class="govuk-error-summary__title">
			There is a problem
		</h2>
		<div class="govuk-error-summary__body">
			<ul class="govuk-list govuk-error-summary__list">
				<li>
					<a href="${1:#}">${2:Enter your full name}</a>
				</li>
				<li>
					<a href="${3:#}">${4:Enter a valid email address}</a>
				</li>
			</ul>
		</div>
	</div>
</div>
]]></content>
	<tabTrigger>govuk-error-summary</tabTrigger>
	<scope>text.html</scope>
	<description>GOV.UK Error summary component</description>
</snippet>
