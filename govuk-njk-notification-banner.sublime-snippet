<snippet>
	<content><![CDATA[
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set html %}
	<p class="govuk-notification-banner__heading">
		${1:You have 7 days left to send your application.}
		<a class="govuk-notification-banner__link" href="${2:#}">${3:View application}</a>.
	</p>
{% endset %}

{{ govukNotificationBanner({
	html: html
}) }}
]]></content>
	<tabTrigger>govuk-njk-notification-banner</tabTrigger>
	<scope>text.html,source.nunjucks</scope>
	<description>GOV.UK Notification Banner (Nunjucks)</description>
</snippet>
